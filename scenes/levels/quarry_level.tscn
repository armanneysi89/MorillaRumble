[node name="Hinweise" type="Node2D" parent="."]

[node name="Hinweis1" type="Node2D" parent="Hinweise"]
position = Vector2(650, 800)
script = ExtResource("3")
text = "Der Bambus lichtet sich: Vitalis Steinbruch liegt im Morgenlicht. Hier oben ist die Luft dünn und der Fels hell."

[node name="Hinweis2" type="Node2D" parent="Hinweise"]
position = Vector2(1750, 800)
script = ExtResource("3")
text = "Suplex (F / G): erst im Klinch greifen, dann über die Schulter werfen. Übe an den Puppen neben dem Thron."

[node name="Hinweis3" type="Node2D" parent="Hinweise"]
position = Vector2(2950, 800)
script = ExtResource("3")
text = "Der Fels ist aufgebrochen. Spring über die Schlucht – die Stege aus Planken tragen dich nach oben."

[node name="Hinweis4" type="Node2D" parent="Hinweise"]
position = Vector2(5250, 800)
script = ExtResource("3")
text = "Eine markierte Bruchplatte versperrt den Weg. Nur der Suplex zerbricht sie – Schläge richten nichts aus."

[node name="Hinweis5" type="Node2D" parent="Hinweise"]
position = Vector2(7150, 800)
script = ExtResource("3")
text = "Hinter der Treppe wartet der Eisenrücken. Weiche seinem Ansturm aus – danach taumelt er. Das ist dein Fenster."

[node name="Hinweis6" type="Node2D" parent="Hinweise"]
position = Vector2(4400, 340)
script = ExtResource("3")
text = "Die Planken führen über die Schlucht hinaus bis zur Aussicht. Von dort siehst du die ganze Arena."

