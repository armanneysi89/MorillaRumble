[node name="Hinweise" type="Node2D" parent="." unique_id=1653472402]

[node name="Hinweis1" type="Node2D" parent="Hinweise" unique_id=294915710]
position = Vector2(520, 800)
script = ExtResource("3")
text = "Der Pfad vom Dojo endet im Mondbambus-Hain. Die Schatten sind hier schon vor dir gewesen."

[node name="Hinweis2" type="Node2D" parent="Hinweise" unique_id=1023772518]
position = Vector2(3000, 800)
script = ExtResource("3")
text = "Dampf und warmes Licht zwischen den Bambusstämmen: Das Saunahaus. Dort könnte Coach Arman sein. Tür öffnen: E / Enter."

[node name="Hinweis3" type="Node2D" parent="Hinweise" unique_id=306055237]
position = Vector2(4660, 800)
script = ExtResource("3")
text = "Q / R (Gamepad: rechter Trigger): Oktopus-Geist beschwören. Er fesselt mehrere Gegner und betäubt sie."

[node name="Hinweis4" type="Node2D" parent="Hinweise" unique_id=587824526]
position = Vector2(5100, 800)
script = ExtResource("3")
text = "Vor dir lauert eine Gruppe. Genau dafür ist der Oktopus-Geist da – danach sind sie leichte Beute."

[node name="Hinweis5" type="Node2D" parent="Hinweise" unique_id=1771728962]
position = Vector2(7150, 800)
script = ExtResource("3")
text = "Die Arena kommt in zwei Wellen. Beschwöre den Geist, wenn du umzingelt bist, und warte seine Abklingzeit ab."

[node name="Hinweis6" type="Node2D" parent="Hinweise" unique_id=1771728963]
position = Vector2(6250, 800)
script = ExtResource("3")
text = "Die Bambusstämme tragen dich bis in die Wipfel. Oben wartet ein Heiltee."

