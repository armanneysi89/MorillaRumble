[node name="Hinweise" type="Node2D" parent="."]

[node name="Hinweis1" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(950, 800)
text = "A / D oder Stick: laufen.  Leertaste: springen – länger halten, höher springen."

[node name="Hinweis2" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(1130, 800)
text = "Shift / Z: Dash. Er macht dich kurz unverwundbar – auch in der Luft (einmal pro Sprung)."

[node name="Hinweis3" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(1700, 800)
text = "J / X: Kombo – mehrfach drücken für Jab, Cross, Hook, Lowkick und Kick.  K / C: schwerer Schlag (langsamer, aber stärker). Übe an der Puppe!"

[node name="Hinweis4" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(2560, 800)
text = "Spring über die Lücke. Wer fällt, verliert ein Leben und startet am letzten Checkpoint."

[node name="Hinweis5" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(3050, 800)
text = "Regale lassen sich von unten durchspringen. Dort oben liegt etwas verborgen."

[node name="Hinweis6" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(3480, 800)
text = "Gegner kündigen Angriffe mit einem roten ! an. Weiche mit Dash aus oder blocke mit L / V."

[node name="Hinweis7" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(5150, 800)
text = "Block im allerletzten Moment pariert den Angriff. Danach greifst du zu: F / G (Kimura)."

[node name="Hinweis8" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(4300, 250)
text = "Die Regale führen weiter nach oben. Wer klettert, findet etwas für den nächsten Kampf."

[node name="Hinweis9" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(2130, 800)
text = "Die Sprungfeder schleudert dich hoch. Von oben erreichst du das Regal – und den Kristall darüber."

[node name="Hinweis10" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(4750, 800)
text = "Holzkisten zerspringen unter deinen Schlägen. Manche verbergen einen Kristall oder einen Heiltee."

[node name="Hinweis11" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(5850, 800)
text = "Der Aufwind trägt dich nach oben. Halte die Richtung, dann landest du auf dem Dach."

[node name="Hinweis12" type="Node2D" parent="Hinweise"]
script = ExtResource("3")
position = Vector2(6900, 800)
text = "Stacheln lassen sich nicht besiegen – springe darüber oder nutze den Dash."

